{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "buildCommand": "",
  "routes": [
    {
      "src": "/admin(.*)",
      "headers": {
        "X-Robots-Tag": "noindex"
      },
      "continue": true
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "fluffydough.xyz"
        }
      ],
      "dest": "/stone/index.html"
    }
  ]
}
